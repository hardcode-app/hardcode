# --- Every setting, with its default -------------------------------------------
# Unset, a setting is compose.yaml's default, which comes with the HardCode you
# run. To change one, write it without the "#", above this part of the file.

# --- Languages and tools -------------------------------------------------------
# INSTALL_<KEY>=true for each language and tool the profile is built around;
# unset, it is off. Each decides what the image installs, which allowlist
# entries HardCode provides and which VS Code extensions the VS Code container
# gets. `hardcode enable`/`disable` and the app's Languages / Tools write them.
# Keys: PYTHON NODE JAVA ANDROID DOTNET GO RUST CPP RUBY PERL, and the tools
# BUILD_ESSENTIALS DOCKER KUBERNETES CLAUDE_CLI CODEX_CLI.
#
# VS Code extensions of your own, beside the languages' (publisher.name,
# comma-separated); only from publishers whose domain the Marketplace verified.
#VSCODE_EXTENSIONS=
#
# Ubuntu packages of your own, beside the languages' (names from Ubuntu
# 26.04's archive, space-separated). The image installs them: a change needs
# a rebuild. `hardcode package add`/`remove` and the app's Languages / Tools
# write it. More than packages: the profile's own Dockerfile steps, in
# image/Dockerfile beside this file (`hardcode image` says where).
#VSCODE_PACKAGES=

# --- VS Code -------------------------------------------------------------------
# Where the web UI is published on this machine. Keep 127.0.0.1 unless you put
# your own TLS/auth in front of it.
#VSCODE_BIND=127.0.0.1
#VSCODE_PORT=11111
# A fixed connection token. Unset: generated on first start and kept in the
# home volume (hardcode open shows it; hardcode token rotate replaces it).
#VSCODE_CONNECTION_TOKEN=
# The folder opened when the URL doesn't name one (unset: the home directory).
#VSCODE_DEFAULT_FOLDER=

# --- Image build (this profile's VS Code image) ---------------------------------
#DEV_USER=dev
# Match your host uid/gid (`id -u`, `id -g`) if you mount host folders. Rootless
# docker always runs as 1000, so with any other value containers see those
# files as owned by "nobody".
#DEV_UID=1000
#DEV_GID=1000
# The initial VS Code .deb ("latest" or e.g. 1.140.0); serve-web updates its
# own server at runtime regardless.
#VSCODE_VERSION=latest
# "latest", e.g. 9.8.0, or "none".
#GRADLE_VERSION=latest
# The Codex CLI release ("latest" or e.g. 0.162.1); rebuild the image to update it.
#CODEX_VERSION=latest
# Kubernetes' kubectl, Helm and kind releases ("latest" or e.g. 1.37.1, 4.3.0,
# 0.33.0); rebuild the image to update them.
#KUBECTL_VERSION=latest
#HELM_VERSION=latest
#KIND_VERSION=latest

# --- Docker daemon ---------------------------------------------------------------
# The rootless Docker daemon beside the VS Code container. "false" leaves it
# out entirely (nothing privileged runs for this profile, `docker` is
# unavailable inside): the harder sandbox. `hardcode docker on|off` or the
# app's Overview switch it.
#ENABLE_DOCKER=true
# Its containers and build steps trust the proxy's CA without being told
# (Java's trust stores too). "true" also sends Java there through the proxy
# (JAVA_TOOL_OPTIONS, which Java announces with a line on stderr).
#DOCKER_JAVA_PROXY=false

# --- Limits ---------------------------------------------------------------------
# Hard memory caps on the VS Code container and on the Docker daemon beside it
# (its containers count against the daemon's). The proxy, DNS and gateway have
# fixed small caps. A process that outgrows its cap is killed, not the host.
#VSCODE_MEMORY=8g
#DOCKER_MEMORY=4g
# ... and how many processes each may run (a fork bomb stops here).
#VSCODE_PIDS=4096
#DOCKER_PIDS=2048

# --- Network ----------------------------------------------------------------------
# The profile's internal network and CoreDNS's fixed address on it (HardCode
# picks a free subnet for each profile). No name may be pinned into it (On
# your network), and the proxy refuses every request to it.
#DEVNET_SUBNET=172.31.253.0/24
#DNS_IP=172.31.253.53
# Where CoreDNS sends allowlisted queries: a resolv.conf path or IPs, e.g.
# "1.1.1.1 9.9.9.9". Unset: this machine's resolvers, through Docker.
#UPSTREAM_DNS=/etc/resolv.conf
# Address ranges an allowlisted name must never resolve to (space-separated;
# unset: loopback, link-local, private and shared ranges). To let one name
# reach one address on your LAN (a git server, a registry), put it On your
# network instead (hardcode lan add NAME), which leaves these as they are.
#EGRESS_INTERNAL_RANGES=
# Who may use the proxy (unset: private, shared and local IPv6 ranges).
#SQUID_CLIENT_RANGES=
# The AppArmor profile for rootless docker. Ubuntu 23.10+ hosts restrict
# unprivileged user namespaces; the stock "rootlesskit" profile allows them.
# Hosts without that profile (non-Ubuntu, older Ubuntu): "unconfined".
#DOCKER_APPARMOR_PROFILE=rootlesskit
